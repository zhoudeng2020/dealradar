# Copy to .env and fill in. Variables prefixed EXPO_PUBLIC_ are bundled into the app.
# For the prototype this is acceptable; restrict the key by bundle ID / package name in
# Google Cloud Console. For production, move Google calls behind your own backend.

# Google Cloud key with "Places API (New)" and "Routes API" enabled.
# Leave empty to run fully offline on seed data + estimated travel times.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Weather uses Open-Meteo (free, no key required).

# Hosted deal catalogue. Leave empty to use only the deals bundled in the app.
# Any https URL serving feed/deals.json will do - a file in a public GitHub repo
# is enough, no server needed. The app validates the feed before using it and
# falls back to the bundled copy if it is unreachable or fails validation.
EXPO_PUBLIC_DEALS_FEED_URL=
